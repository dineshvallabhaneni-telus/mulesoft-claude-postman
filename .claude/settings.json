{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",

      "Bash(git --version)",
      "Bash(java -version)",
      "Bash(mvn --version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(python --version)",
      "Bash(postman --version)",
      "Bash(anypoint-cli --version)",
      "Bash(ayx --version)",

      "Bash(git clone *)",
      "Bash(git fetch *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-tree *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git remote -v)",

      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(command -v *)",

      "Bash(unzip *)",
      "Bash(sha256sum *)",
      "Bash(shasum *)",
      "Bash(certutil *)"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)"
    ]
  },
  "env": {
    "PROJECT_ROOT": "."
  }
}
