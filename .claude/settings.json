{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",

      "Write(workspace/execution/**)",
      "Edit(workspace/execution/**)",
      "Write(reports/**)",

      "Bash(python3 scripts/source_compare.py)",
      "Bash(python3 scripts/source_compare.py *)",
      "Bash(python3 scripts/run_postman.py)",
      "Bash(python3 scripts/run_postman.py *)",
      "Bash(python3 scripts/generate_report.py)",
      "Bash(python3 scripts/generate_report.py *)",

      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(cat workspace/execution/*)",
      "Bash(python3 --version)",
      "Bash(newman --version)"
    ],
    "deny": [
      "Write(previous_ws/**)",
      "Edit(previous_ws/**)",
      "Write(postman_collection/**)",
      "Edit(postman_collection/**)",
      "Write(src/**)",
      "Edit(src/**)",
      "Write(pom.xml)",
      "Edit(pom.xml)",

      "Bash(git clone *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git reset *)",

      "Bash(anypoint-cli *)",
      "Bash(ayx *)",
      "Bash(mvn deploy *)",
      "Bash(curl *anypoint*)",
      "Bash(rm -rf *)"
    ]
  }
}
